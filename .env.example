# Backend runtime
LOG_LEVEL=INFO
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-this-in-production
BACKEND_PORT=5000
FRONTEND_PORT=3000
CORS_ORIGINS=*

# User-facing AI settings are fixed in the application:
# AI_PROVIDER_FORMAT=openai
# OPENAI_API_BASE=https://max.aittco.com
# TEXT_MODEL=gpt-5.4
# IMAGE_MODEL=gpt-image-2
# IMAGE_CAPTION_MODEL=gpt-5.4
#
# Do not put the user's API key here. Users must enter their own API Key
# in the Settings page before AI features can be used.

# Hidden service configuration
MAX_DESCRIPTION_WORKERS=5
MAX_IMAGE_WORKERS=8
MINERU_TOKEN=your-mineru-token
MINERU_API_BASE=https://mineru.net
BAIDU_API_KEY=your-baidu-api-key

# Access code is optional. Leave empty to disable access-code checks.
# ACCESS_CODE=your-access-code-here

# Output language: zh, en, ja, auto
OUTPUT_LANGUAGE=zh
